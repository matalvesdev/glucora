# Required: PostgreSQL connection URI; server-only secret.
DATABASE_URL=
# Required by local Compose; generated by pnpm env:init.
POSTGRES_PASSWORD=
# Optional integer 1..65535; API defaults to 3001.
PORT=
# Optional bind address; defaults to 127.0.0.1.
HOST=
# Optional development, test, production; defaults to development.
NODE_ENV=
# Optional safe logging level; defaults to info.
LOG_LEVEL=
# Optional: disabled by default. Use development only outside production.
AUTH_ADAPTER=
