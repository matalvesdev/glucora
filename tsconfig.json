{
  "extends": "./packages/config/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@glucora/contracts": ["packages/contracts/src/index.ts"],
      "@glucora/config": ["packages/config/src/index.ts"],
      "@glucora/observability": ["packages/observability/src/index.ts"],
      "@glucora/ui": ["packages/ui/src/index.ts"],
      "@glucora/test-utils": ["packages/test-utils/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "services/**/*.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "*.ts"
  ],
  "exclude": ["**/dist", "node_modules"]
}
